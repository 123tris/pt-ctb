# Response headers for Cloudflare Pages (tools/build-site.mjs copies this file into dist/; it isn't served itself).
# Rules that match the same path add up, so they're kept from overlapping on any one header. Pages doesn't apply
# these to the /auth/* Functions, which set their own.
#
# {{inline-script-hashes}} becomes the hashes of the inline <script>s and on…="" handlers in index.html and 404.html,
# worked out by tools/build-site.mjs on every build, so editing those snippets can't silently get them blocked.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{inline-script-hashes}}; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://a.ppy.sh https://assets.ppy.sh; connect-src 'self' https://data.ptcatch.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The data isn't served from here: it comes from https://data.ptcatch.com (R2), whose caching is set per file by
# tools/r2-sync.mjs (meta.json no-cache, the rest a week, fetched as x.json?v=<content hash>).

# Images rarely change.
/assets/img/*
  Cache-Control: public, max-age=604800

# Code and fonts are only ever asked for as x.js?v=<hash of all the code> (tools/build-site.mjs puts it on every
# address in index.html, every import and every url() in the CSS), so a deploy that changes any of them changes every
# address, and an address never gets other content: browsers can keep them for a year without asking again. (The old
# no-cache here was turned into max-age=14400 by the zone's Browser Cache TTL anyway, which only raises shorter times;
# after 4 hours each visit re-checked ~20 files.) A stale module next to fresh ones breaks the page ("does not provide
# an export named …"), which is why nothing may load them without the ?v=.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
