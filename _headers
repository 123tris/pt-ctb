# Response headers for Cloudflare Pages (tools/build-site.mjs copies this file into dist/; it isn't served itself).
# Rules that match the same path add up, so they're kept from overlapping on any one header. Pages doesn't apply
# these to the /auth/* Functions, which set their own.
#
# {{inline-script-hashes}} becomes the hashes of the inline <script>s and on…="" handlers in index.html and 404.html,
# worked out by tools/build-site.mjs on every build, so editing those snippets can't silently get them blocked.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{inline-script-hashes}}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://a.ppy.sh https://assets.ppy.sh; connect-src 'self' https://data.ptcatch.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The data isn't served from here: it comes from https://data.ptcatch.com (R2), whose caching is set per file by
# tools/r2-sync.mjs (meta.json no-cache, the rest a week, fetched as x.json?v=<content hash>).

# Images rarely change.
/assets/img/*
  Cache-Control: public, max-age=604800

# A stale module next to fresh ones breaks the page ("does not provide an export named …"). On ptcatch.com the zone's
# Browser Cache TTL still turns this into max-age=14400 (checked 2026-10-25), so the real fix is in
# tools/build-site.mjs: every JS/CSS address carries ?v=<code hash>. This rule only helps on *.pages.dev.
/assets/js/*
  Cache-Control: no-cache
/assets/css/*
  Cache-Control: no-cache
