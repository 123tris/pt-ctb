#!/bin/sh
# Refuses a push that would take Cloudflare Pages past its free-plan build budget (tools/build-budget.mjs).
# Turn it on for every worktree, including ones on branches older than this hook (absolute path, so they find it too):
#   git config core.hooksPath C:/Repos/pt-ctb-dev/tools/git-hooks
# If node can't run the check, the push goes ahead with a warning rather than blocking work.
script="$(dirname "$0")/../build-budget.mjs"
[ -f "$script" ] || script="$(git rev-parse --show-toplevel)/tools/build-budget.mjs"
if [ -f "$script" ] && command -v node >/dev/null 2>&1; then
  node "$script" pre-push "$1"
  exit $?
fi
echo "build budget: tools/build-budget.mjs or node not found; pushing without the Pages build check." >&2
exit 0
